# Names must be OPENAI_* (OpenAI SDK). DeepSeek example:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional. Preferred in China: 高德 Web 服务 Key（地理编码 + POI）
# https://console.amap.com/ — bind「Web服务」
AMAP_API_KEY=
# Optional. POI fallback: OpenStreetMap Overpass (no key).
# OpenTripMap only if you already have a key: https://dev.opentripmap.org
OPENTRIPMAP_API_KEY=
NOMINATIM_USER_AGENT=my-travel-agent/0.1 (local-dev; contact=dev@example.com)
TOOL_TIMEOUT_SEC=12
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=30
TRACE_DIR=traces
LOG_LEVEL=INFO
