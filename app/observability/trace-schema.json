{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sigrid000/my-travel-agent/app/observability/trace-schema.json",
  "title": "TravelAgentTraceEvent",
  "description": "One JSON object per line in traces/{trace_id}.jsonl",
  "type": "object",
  "required": ["ts", "trace_id", "session_id", "kind"],
  "properties": {
    "ts": { "type": "string", "description": "ISO-8601 UTC timestamp" },
    "trace_id": { "type": "string" },
    "session_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "user_message",
        "intent",
        "safety_block",
        "preferences",
        "clarify",
        "destination_suggest",
        "prefetch",
        "llm_request",
        "llm_response",
        "agent_step",
        "tool_result",
        "final_rejected",
        "budget_adjust",
        "final"
      ]
    },
    "content": { "type": "string", "description": "Full text for user_message / final" },
    "content_chars": { "type": "integer", "description": "Length of final content" },
    "content_preview": { "type": "string", "description": "Truncated LLM reply for llm_response" },
    "result_preview": { "type": "string", "description": "Truncated tool result for tool_result" },
    "step": { "type": "integer" },
    "tool": { "type": "string" },
    "args": { "type": "object" },
    "prompt_tokens": { "type": "integer" },
    "completion_tokens": { "type": "integer" },
    "prompt_chars": { "type": "integer" },
    "failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "intent": { "type": "string" },
    "lane": { "type": "string" },
    "reason": { "type": "string" },
    "summary": { "type": "string" },
    "missing": {
      "type": "array",
      "items": { "type": "string" }
    },
    "weather_scenario": { "type": ["string", "null"] },
    "start_date": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
